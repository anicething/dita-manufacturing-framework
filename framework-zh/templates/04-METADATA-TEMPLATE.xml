<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE metadata PUBLIC "-//OASIS//DTD DITA Metadata//EN" "metadata.dtd">
<!--
  元数据模板 (T4)
  将此块复制到任何主题的 <prolog> 部分中。
  将所有方括号中的 [占位符] 替换为您的实际值。
  所有值必须来自主题方案（见 framework/ 目录）。
-->
<metadata>
  <!-- === 文档标识 === -->
  <data name="docid" value="[DOC-PROD-NNN-vX.Y]"/>
  <data name="internal-id" value="[topic-id]"/>

  <!-- === 分类信息 === -->
  <data name="product" value="[MC-5000|MC-8000|DR-2000|common]"/>
  <data name="product-version" value="[X.X+]"/>
  <data name="audience" value="[operator|maintenance|engineer|field-service|trainer|all]"/>
  <data name="topic-type" value="[concept|task|reference|troubleshooting|glossary-entry|hazard-statement|task-requirements|learning-object]"/>

  <!-- === 合规与状态 === -->
  <data name="status" value="[draft|review|approved|published|archived]"/>
  <data name="security-level" value="[public|internal|confidential]"/>
  <data name="iso-relevant" value="[yes|no]"/>

  <!-- === 审核与维护 === -->
  <data name="created-date" value="[YYYY-MM-DD]"/>
  <data name="revised-date" value="[YYYY-MM-DD]"/>
  <data name="author" value="[作者姓名]"/>
  <data name="reviewed-by" value="[审核人姓名]"/>
  <data name="next-review-date" value="[YYYY-MM-DD]"/>
  <data name="review-frequency" value="[quarterly|biannual|annual]"/>

  <!-- === 本地化 === -->
  <data name="translatable" value="[yes|no]"/>
  <data name="translation-status" value="[original|translated]"/>
  <data name="language" value="[en-US|zh-CN|de-DE|fr-FR|es-ES|ja-JP|ko-KR|pt-BR|it-IT]"/>
</metadata>
