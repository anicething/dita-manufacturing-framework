<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="r_template_reference" xml:lang="zh-CN">
  <title>模板：参考主题 — 请替换为主题名称</title>
  <shortdesc>简要描述本参考主题包含的内容。用户为什么需要查阅此内容？</shortdesc>
  <prolog>
    <metadata>
      <!-- 必填：文档 ID -->
      <data name="docid" value="DOC-PROD-XXX-v1.0"/>

      <!-- 必填：分类信息 -->
      <data name="product" value="Product A"/>
      <data name="product-version" value="1.0+"/>
      <data name="audience" value="developer|admin"/>
      <data name="status" value="draft"/>

      <!-- 必填：审核信息 -->
      <data name="created-date" value="2026-01-15"/>
      <data name="revised-date" value="2026-06-06"/>
      <data name="author" value="Your Name"/>
      <data name="reviewed-by" value="Reviewer Name"/>
      <data name="review-frequency" value="quarterly"/>

      <!-- 必填：合规信息 -->
      <data name="security-level" value="public"/>
      <data name="translatable" value="yes"/>
    </metadata>
  </prolog>

  <refbody>
    <!-- 用途 -->
    <section>
      <title>用途</title>
      <p>用户何时需要这些信息？
        它解决了什么问题？</p>
    </section>

    <!-- 选项/参数表 -->
    <section>
      <title>参数或选项</title>
      <table frame="all" rowheader="firstcol">
        <title>配置参数</title>
        <tgroup cols="4">
          <colspec colname="c1" colwidth="1.5*"/>
          <colspec colname="c2" colwidth="1*"/>
          <colspec colname="c3" colwidth="1*"/>
          <colspec colname="c4" colwidth="2*"/>
          <thead>
            <row>
              <entry>参数</entry>
              <entry>有效值</entry>
              <entry>默认值</entry>
              <entry>描述</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>PARAMETER_NAME</entry>
              <entry>value1, value2</entry>
              <entry>value1</entry>
              <entry>此参数的功能</entry>
            </row>
            <row>
              <entry>PARAM_2</entry>
              <entry>0-100</entry>
              <entry>50</entry>
              <entry>参数2的描述</entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

    <!-- 示例 -->
    <section>
      <title>示例</title>
      <p>提供 1-2 个实际示例：</p>
      <codeblock>
# 示例 1：如何使用此功能
PARAMETER_NAME = value1
PARAM_2 = 75
      </codeblock>
    </section>

    <!-- 错误码 / 返回值 -->
    <section>
      <title>返回值或错误码</title>
      <table frame="all" rowheader="firstcol">
        <title>错误码</title>
        <tgroup cols="2">
          <colspec colname="c1" colwidth="1*"/>
          <colspec colname="c2" colwidth="2*"/>
          <thead>
            <row>
              <entry>代码</entry>
              <entry>含义</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>0</entry>
              <entry>成功 — 操作已完成</entry>
            </row>
            <row>
              <entry>1</entry>
              <entry>错误 — 参数无效</entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

    <!-- 相关主题 -->
    <section>
      <title>相关参考</title>
      <ul>
        <li><xref href="[related-reference-topic].dita">相关参考主题</xref></li>
        <li><xref href="[related-concept-topic].dita">相关概念：了解该功能</xref></li>
        <li><xref href="[related-task-topic].dita">相关任务：如何配置</xref></li>
      </ul>
    </section>
  </refbody>
</reference>
