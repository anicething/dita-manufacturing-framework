<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="t_template_task" xml:lang="zh-CN">
  <title>模板：如何做某事 — 请替换此标题</title>
  <shortdesc>此任务说明如何完成特定目标。请替换为您的任务描述。</shortdesc>
  <prolog>
    <metadata>
      <!-- 必填：文档 ID -->
      <data name="docid" value="DOC-PROD-XXX-v1.0"/>

      <!-- 必填：分类信息 -->
      <data name="product" value="Product A"/>
      <data name="product-version" value="1.0+"/>
      <data name="audience" value="admin|user|developer"/>
      <data name="status" value="draft"/>

      <!-- 必填：审核信息 -->
      <data name="created-date" value="2026-01-15"/>
      <data name="revised-date" value="2026-06-06"/>
      <data name="author" value="Your Name"/>
      <data name="reviewed-by" value="Reviewer Name"/>
      <data name="review-frequency" value="quarterly"/>

      <!-- 必填：合规信息 -->
      <data name="security-level" value="public"/>
      <data name="translatable" value="yes"/>
    </metadata>
  </prolog>

  <taskbody>
    <!-- 第1节：前提条件 -->
    <prereq>
      <p>列出用户在开始之前需要准备的事项：</p>
      <ul>
        <li>要求 1</li>
        <li>要求 2</li>
        <li>您已阅读：<xref href="[related-concept-topic].dita">概念主题名称</xref></li>
      </ul>
    </prereq>

    <!-- 第2节：背景说明 -->
    <context>
      <p>解释用户为什么以及何时需要执行此任务。
        预计完成时间：X 分钟</p>
    </context>

    <!-- 第3节：逐步操作说明 -->
    <steps>
      <step>
        <cmd>第一步操作（使用动作动词）。</cmd>
        <info>包含有关此步骤的任何有帮助的信息。</info>
        <stepresult>此步骤完成后应该出现的结果。</stepresult>
      </step>

      <step>
        <cmd>第二步操作。</cmd>
        <info>如有需要，提供附加信息。</info>
        <stepresult>此步骤完成后的预期结果。</stepresult>
      </step>

      <step>
        <cmd>第三步操作。</cmd>
        <stepresult>所有步骤完成后的最终结果。</stepresult>
      </step>
    </steps>

    <!-- 第4节：预期结果 -->
    <result>
      <p>描述用户在完成这些步骤后应该看到什么或能够做到什么。
        这用于确认任务已成功完成。</p>
    </result>

    <!-- 第5节：提示与故障排除 -->
    <postreq>
      <p><b>提示：</b></p>
      <ul>
        <li>帮助提示 1</li>
        <li>帮助提示 2</li>
      </ul>
      <p><b>故障排除：</b></p>
      <ul>
        <li>如果出现 X，请尝试 Y。参见 <xref href="[troubleshooting-topic].dita">故障排除</xref>。</li>
      </ul>
      <p><b>下一步：</b></p>
      <ul>
        <li><xref href="[next-task-topic].dita">下一个相关任务</xref></li>
      </ul>
    </postreq>
  </taskbody>
</task>
