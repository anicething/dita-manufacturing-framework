<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<!--
  任务前提条件模板
  使用标准 DITA 元素在 <prereq> 中记录前提条件
  （人员、设备、零件、环境、安全）。
-->
<task id="template-task-with-requirements"
      xml:lang="zh-CN">
  <title>[任务标题：动词 + 宾语]</title>
  <shortdesc>[一句话总结任务内容]。</shortdesc>
  <prolog>
    <metadata>
      <audience type="maintenance" job="technician" experiencelevel="experienced"/>
      <category>[类别]</category>
      <prodinfo>
        <prodname>[产品名称]</prodname>
        <vrmlist>
          <vrm version="X.X" release="X" modification="X"/>
        </vrmlist>
      </prodinfo>
      <othermeta name="content-type" content="task"/>
      <othermeta name="estimated-time" content="[分钟数]"/>
      <othermeta name="required-skill-level" content="[技能等级 X]"/>
    </metadata>
  </prolog>
  <taskbody>
    <!-- ===== 前提条件（人员、设备、零件、环境、安全） ===== -->
    <prereq>
      <p>开始此任务前，请确保满足以下要求：</p>
      <p><b>人员：</b></p>
      <ul>
        <li>所需技能等级：[1-5] — [描述]</li>
        <li>所需认证：[认证名称（如有）]</li>
      </ul>
      <p><b>设备：</b></p>
      <ul>
        <li>[工具或仪器名称]（P/N: XXX）</li>
        <li>[附加工具]（P/N: XXX）</li>
      </ul>
      <p><b>零件：</b></p>
      <ul>
        <li>[耗材或替换零件]（P/N: XXX）</li>
      </ul>
      <p><b>环境条件：</b></p>
      <ul>
        <li>温度：[最低°C] 至 [最高°C]</li>
        <li>湿度：不超过 [%]</li>
        <li>洁净度：[ISO 等级]</li>
      </ul>
      <note type="attention">
        <xref href="[危险主题ID].dita">所需安全预防措施</xref>
      </note>
    </prereq>

    <!-- ===== 步骤 ===== -->
    <steps id="task-steps">
      <step id="step-1">
        <cmd>第一步动作动词 + 宾语。</cmd>
        <info>辅助详细信息。</info>
        <stepresult>此步骤的预期结果。</stepresult>
      </step>
      <step id="step-n">
        <cmd>最后一步。</cmd>
      </step>
    </steps>

    <!-- ===== 后续要求 ===== -->
    <postreq>
      <p>完成此任务后需要做什么。</p>
    </postreq>
  </taskbody>
</task>
