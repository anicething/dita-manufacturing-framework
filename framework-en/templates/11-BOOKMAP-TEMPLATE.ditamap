<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bookmap PUBLIC "-//OASIS//DTD DITA BookMap//EN" "bookmap.dtd">
<bookmap id="template-bookmap"
         xml:lang="en-US"
         title="[Product Name] — [Document Type]"
>
  <booktitle>
    <mainbooktitle>[Product Name] [Document Type]</mainbooktitle>
    <booktitlealt>Version X.X — [Edition info]</booktitlealt>
    <navtitle>[Short navigation title]</navtitle>
  </booktitle>

  <bookmeta>
    <author>ExampleCorp Documentation Team</author>
    <publisher>Example Manufacturing Co., Ltd.</publisher>
    <copyright>
      <copyryear year="2026"/>
      <copyrholder>Example Manufacturing Co., Ltd.</copyrholder>
    </copyright>
    <bookid>
      <booknumber>DOC-[PROD]-[NUM]-[LANG]</booknumber>
      <edition>X.X</edition>
    </bookid>
    <critdates>
      <created date="2026-01-15"/>
      <revised date="2026-06-01"/>
    </critdates>
    <prodinfo>
      <prodname>[Product Name]</prodname>
      <vrmlist>
        <vrm version="X.X" release="X" modification="X"/>
      </vrmlist>
    </prodinfo>
  </bookmeta>

  <!-- ===== FRONT MATTER ===== -->
  <frontmatter>
    <booklists>
      <toc/>
      <figurelist/>
      <tablelist/>
      <abbrevlist/>
    </booklists>
    <notices/>
    <preface href="[preface-topic].dita">
      <topicmeta><navtitle>Preface</navtitle></topicmeta>
    </preface>
  </frontmatter>

  <!-- ===== CHAPTERS ===== -->
  <chapter id="ch-safety" navtitle="Safety">
    <topicref href="[safety-overview].dita" navtitle="Safety Overview"/>
    <topicref href="[hazard-statements].dita" navtitle="Hazard Statements"/>
  </chapter>

  <chapter id="ch-installation" navtitle="Installation">
    <topicref href="[installation-overview].dita" navtitle="Installation Overview"/>
    <topicref href="[unpacking-task].dita" navtitle="Unpacking"/>
    <topicref href="[setup-task].dita" navtitle="Setup and Alignment"/>
  </chapter>

  <chapter id="ch-operation" navtitle="Operation">
    <topicref href="[operation-overview].dita" navtitle="Operation Overview"/>
    <topicref href="[daily-checks-task].dita" navtitle="Daily Checks"/>
  </chapter>

  <chapter id="ch-maintenance" navtitle="Maintenance">
    <topicref href="[maintenance-overview].dita" navtitle="Maintenance Overview"/>
    <topicref href="[spindle-alignment-task].dita" navtitle="Spindle Alignment"/>
  </chapter>

  <chapter id="ch-troubleshooting" navtitle="Troubleshooting">
    <topicref href="[ts-alarms].dita" navtitle="Alarm Code Reference"/>
    <topicref href="[ts-common].dita" navtitle="Common Problems"/>
  </chapter>

  <!-- ===== BACK MATTER ===== -->
  <backmatter>
    <appendix id="app-specs" navtitle="Technical Specifications">
      <topicref href="[specs-reference].dita"/>
    </appendix>
    <appendix id="app-glossary" navtitle="Glossary">
      <topicref href="[glossary-map].ditamap"/>
    </appendix>
    <amendments/>
    <indexlist/>
  </backmatter>
</bookmap>
