<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glossentry PUBLIC "-//OASIS//DTD DITA Glossary//EN" "glossentry.dtd">
<glossentry id="template-glossary-entry"
            xml:lang="en-US">
  <glossterm>[Term Name]</glossterm>
  <glossdef>
    <p>A clear, concise definition of the term. Use one or two sentences.
       Include domain context if the term has multiple meanings.</p>
  </glossdef>
  <prolog>
    <metadata>
      <audience type="all"/>
      <category>Glossary</category>
      <othermeta name="content-type" content="glossary-entry"/>
      <othermeta name="glossary-domain" content="[safety|technical|commercial|legal]"/>
      <othermeta name="translatable" content="yes"/>
    </metadata>
  </prolog>

  <!-- Optional: related terms (add as separate glossary entries with cross-references) -->
  <related-links>
    <link href="[related-term-file].dita">
      <linktext>[Related Term Name]</linktext>
    </link>
  </related-links>
</glossentry>
