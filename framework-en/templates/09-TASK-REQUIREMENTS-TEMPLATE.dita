<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<!--
  Task Requirements template
  Documents prerequisites (personnel, equipment, parts, environment, safety)
  using standard DITA elements within <prereq>.
-->
<task id="template-task-with-requirements"
      xml:lang="en-US">
  <title>[Task Title: Verb + Object]</title>
  <shortdesc>[One-sentence summary of the task].</shortdesc>
  <prolog>
    <metadata>
      <audience type="maintenance" job="technician" experiencelevel="experienced"/>
      <category>[Category]</category>
      <prodinfo>
        <prodname>[Product Name]</prodname>
        <vrmlist>
          <vrm version="X.X" release="X" modification="X"/>
        </vrmlist>
      </prodinfo>
      <othermeta name="content-type" content="task"/>
      <othermeta name="estimated-time" content="[minutes]"/>
      <othermeta name="required-skill-level" content="[Level X]"/>
    </metadata>
  </prolog>
  <taskbody>
    <!-- ===== PREREQUISITES (personnel, equipment, parts, environment, safety) ===== -->
    <prereq>
      <p>Before starting this task, ensure the following requirements are met:</p>
      <p><b>Personnel:</b></p>
      <ul>
        <li>Required skill level: [1-5] — [description]</li>
        <li>Required certification: [certification name (if any)]</li>
      </ul>
      <p><b>Equipment:</b></p>
      <ul>
        <li>[Tool or instrument name] (P/N: XXX)</li>
        <li>[Additional tool] (P/N: XXX)</li>
      </ul>
      <p><b>Parts:</b></p>
      <ul>
        <li>[Consumable or replacement part] (P/N: XXX)</li>
      </ul>
      <p><b>Environmental conditions:</b></p>
      <ul>
        <li>Temperature: [min°C] to [max°C]</li>
        <li>Humidity: max [%]</li>
        <li>Cleanliness: [ISO class]</li>
      </ul>
      <note type="safety">
        <xref href="[hazard-topic-id].dita">Required safety precaution</xref>
      </note>
    </prereq>

    <!-- ===== STEPS ===== -->
    <steps id="task-steps">
      <step id="step-1">
        <cmd>First action verb + object.</cmd>
        <info>Supporting detail.</info>
        <stepresult>Expected result of this step.</stepresult>
      </step>
      <step id="step-n">
        <cmd>Final step.</cmd>
      </step>
    </steps>

    <!-- ===== POST-REQUISITES ===== -->
    <postreq>
      <p>What to do after completing the task.</p>
    </postreq>
  </taskbody>
</task>
