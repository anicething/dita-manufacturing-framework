  <shortdesc>This task explains how to accomplish a specific goal. Replace with your task description.</shortdesc>
  <prolog>
    <metadata>
      <!-- REQUIRED: Document ID -->
      <data name="docid" value="DOC-PROD-XXX-v1.0"/>
      
      <!-- REQUIRED: Classification -->
      <data name="product" value="Product A"/>
      <data name="product-version" value="1.0+"/>
      <data name="audience" value="admin|user|developer"/>
      <data name="status" value="draft"/>
      
      <!-- REQUIRED: Review Info -->
      <data name="created-date" value="2026-01-15"/>
