      <!-- REQUIRED: Compliance -->
      <data name="security-level" value="public"/>
      <data name="translatable" value="yes"/>
    </metadata>
  </prolog>
  
  <taskbody>
    <!-- SECTION 1: Prerequisites -->
    <prereq>
      <p>List anything users need before starting:</p>
      <ul>
        <li>Requirement 1</li>
        <li>Requirement 2</li>
        <li>You have read: <xref href="[related-concept-topic].dita">Concept Topic Name</xref></li>
      </ul>
    </prereq>

    <!-- SECTION 2: Context -->
    <context>
      <p>Explain why and when users would perform this task.
        Estimated time to complete: X minutes</p>
    </context>

    <!-- SECTION 3: Step-by-Step Instructions -->
    <steps>
      <step>
        <cmd>First action (use action verb).</cmd>
        <info>Include any helpful info about this step.</info>
        <stepresult>What should happen after this step.</stepresult>
      </step>
      
      <step>
        <cmd>Second action.</cmd>
        <info>Additional information if needed.</info>
        <stepresult>Expected result after this step.</stepresult>
      </step>
      
      <step>
        <cmd>Third action.</cmd>
        <stepresult>Final result when all steps are complete.</stepresult>
      </step>
    </steps>
    
    <!-- SECTION 4: Expected Result -->
    <result>
      <p>Describe what the user should see or be able to do after completing these steps.
        This confirms successful completion.</p>
    </result>
    
    <!-- SECTION 5: Tips & Troubleshooting -->
    <postreq>
      <p><b>Tips:</b></p>
      <ul>
        <li>Helpful tip 1</li>
        <li>Helpful tip 2</li>
      </ul>
      <p><b>Troubleshooting:</b></p>
      <ul>
        <li>If X happens, try Y. See <xref href="[troubleshooting-topic].dita">Troubleshooting</xref>.</li>
      </ul>
      <p><b>Next steps:</b></p>
      <ul>
        <li><xref href="[next-task-topic].dita">Next related task</xref></li>
      </ul>
